{
  "manifest_version": 3,
  "name": "AutoFill Excel Temps Réel",
  "version": "1.1",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Ouvrir l'automate Excel"
  }
}